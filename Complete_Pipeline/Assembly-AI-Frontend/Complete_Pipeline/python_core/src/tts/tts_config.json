{
  "_comment": "Pick the provider here. Secrets: write ${ENV_VAR} and put the real value in your .env file (never commit it). See tts_config.examples.json for ready-made REST setups.",
  "provider": "http",
  "providers": {
    "mock": {
      "bytes_per_char": 320,
      "block_bytes": 1000,
      "delay_s": 0.0
    },
    "http": {
      "url": "https://api.elevenlabs.io/v1/text-to-speech/{voice_id}/stream",
      "method": "POST",
      "headers": { "Content-Type": "application/json", "xi-api-key": "${ELEVENLABS_API_KEY}" },
      "query": { "output_format": "pcm_16000" },
      "body": { "text": "<TEXT>", "model_id": "eleven_flash_v2_5" },
      "variables": { "voice_id": "${ELEVENLABS_VOICE_ID}" },
      "text_placeholder": "<TEXT>",
      "timeout_s": 10.0,
      "read_block_bytes": 4096
    },
    "system": {
      "sample_rate": 16000,
      "block_size_bytes": 4096,
      "voice": "",
      "rate": 0,
      "volume": 1.0
    }
  },
  "event_types": {
    "chunk": "audio.chunk",
    "final": "audio.final"
  },
  "event_version": 1,
  "audio_format": {
    "encoding": "pcm_s16le",
    "sample_rate": 16000,
    "channels": 1,
    "sample_width_bytes": 2
  },
  "chunk_size_bytes": 4096,
  "max_retries": 2,
  "retry_backoff_s": 0.2
}